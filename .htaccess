# Smart Realty USA — GoDaddy / Apache
# ==================================
# FIRST DEPLOY: Basic Auth is OFF so a wrong AuthUserFile path cannot 500 the site.
# In-app password gate still protects the demo (SmartRealty2026).
#
# AFTER site loads:
#   1. Uncomment the Basic Auth block below
#   2. Set AuthUserFile to the FULL server path of .htpasswd
#      Example: /home/yourcpaneluser/public_html/.htpasswd
#   3. Uncomment HTTPS redirect AFTER AutoSSL is Active
#   4. If you get HTTP 500, rename this file to .htaccess.off temporarily
#
# Full guide: CUSTOM-DOMAIN-WALKTHROUGH.md · SHIP-NOW.md

# --- Private demo Basic Auth (OFF for first deploy — enable after path is correct) ---
# AuthType Basic
# AuthName "Smart Realty USA — Private Demo"
# AuthUserFile /home/USERNAME/public_html/.htpasswd
# Require valid-user

# --- Force HTTPS (enable after SSL certificate is Active) ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Optional: www → apex (enable if siteUrl is non-www) ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
# </IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Discourage indexing of private demo
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# --- Cache static assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Hide credentials file
<Files ".htpasswd">
  Require all denied
</Files>

# Block markdown / shell docs if accidentally uploaded
<FilesMatch "\.(md|sh)$">
  Require all denied
</FilesMatch>
<Files "SHARE-EMAIL.txt">
  Require all denied
</Files>
<Files "GO-LIVE-CHECKLIST.md">
  Require all denied
</Files>

DirectoryIndex index.html
