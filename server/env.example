# Copy to server/.env (gitignored). Never commit real secrets.

# --- Existing auth ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_DAYS=14
AUTH_PORT=8787
CORS_ORIGIN=http://127.0.0.1:8787
# DEMO_PASSWORD=  # optional; 12+ chars; never a published value

# Serve the static website from this API during local Direct Deposit preview.
SERVE_STATIC=1

# --- SmartRealty Direct Deposit ---
# mock     = full UX, no real payroll or ACH instructions (default)
# provider = call an approved payroll-switch partner; stays off until
#            credentials AND compliance approvals exist.
DIRECT_DEPOSIT_MODE=mock

# HMAC secret for POST /api/webhooks/direct-deposit
# Required in provider mode. Optional in mock (tests supply their own).
DIRECT_DEPOSIT_WEBHOOK_SECRET=

# When "1", mock banking returns clearly labeled SANDBOX account/routing
# fixtures so Reveal/Copy can be tested. Default is unprovisioned (no numbers).
DIRECT_DEPOSIT_SANDBOX_ACCOUNT_DETAILS=0

# Approved payroll-switch partner (Pinwheel is the designed adapter).
# Leave empty. Provider mode will not activate without these.
PINWHEEL_API_SECRET=
PINWHEEL_API_URL=https://sandbox.getpinwheel.com
PINWHEEL_WEBHOOK_SECRET=

# Future: Neon Postgres. File store is used until DATABASE_URL is wired.
# DATABASE_URL=

# HARD RULE: production financial activity is disabled in code.
# DIRECT_DEPOSIT_PRODUCTION=1 is ignored.

# --- Billing / profit engine ---
# mock   = sandbox checkout, no cards, no live charges (default)
# stripe = real adapter (server/profit/billing/stripe.js); stays sandboxed
#          until keys AND config.js's hard-coded productionApproved=true
#          (a deliberate code edit, not an env var) both exist.
BILLING_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
APP_BASE_URL=http://127.0.0.1:8787
# Price IDs from the Stripe dashboard (Products > Pricing), test or live mode
# matching whichever STRIPE_SECRET_KEY is set. Checkout for a plan with no
# price configured fails clearly instead of silently falling back.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_AGENT_STARTER_MONTHLY=
STRIPE_PRICE_AGENT_STARTER_ANNUAL=
STRIPE_PRICE_AGENT_PRO_MONTHLY=
STRIPE_PRICE_AGENT_PRO_ANNUAL=
STRIPE_PRICE_BROKERAGE_MONTHLY=
STRIPE_PRICE_BROKERAGE_ANNUAL=
# ADMIN_PASSWORD is used by /api/admin/profit (optional; 8+ chars).
ADMIN_PASSWORD=
# HARD RULE: live charging is disabled in code.
# BILLING_PRODUCTION=1 is ignored.

# --- Listings (MLS data) ---
# mock     = fictional sample listings, no external calls (default)
# provider = query a RESO Web API endpoint (MLS Grid / Bridge / Spark);
#            stays off until credentials exist AND config.js's hard-coded
#            idxAgreementAccepted=true (a deliberate code edit, not an env
#            var, confirming a signed IDX/MLS data-license agreement) is set.
LISTINGS_MODE=mock
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
RESO_TOKEN_URL=
RESO_QUERY_URL=
# HARD RULE: live MLS data is disabled in code until a signed IDX/MLS
# data-license agreement exists. There is no env var for this — see
# config.js's idxAgreementAccepted.
