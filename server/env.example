# Copy to server/.env and replace every placeholder locally. Never commit .env.
AUTH_PORT=8787
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_DAYS=14
CORS_ORIGIN=https://smartrealty.us
DEMO_PASSWORD=
ADMIN_PASSWORD=
SERVE_STATIC=0

# Listings stay on labeled sample data unless a legal IDX/MLS agreement exists.
LISTINGS_MODE=mock
LISTINGS_HUD_REGIONS=KY,IN
LISTINGS_ALLOW_HUD_SAMPLE=0
LISTINGS_SYNC_INTERVAL_MS=3600000
LISTINGS_HOURLY_SYNC=1
LISTINGS_ABSENT_STREAK_LIMIT=3

# Optional provider and image services. Keep secrets in server/.env only.
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
RESO_TOKEN_URL=
RESO_QUERY_URL=
GOOGLE_STREET_VIEW_KEY=
