# Smart Realty USA — API (GoDaddy Apache)
# Pretty paths → PHP files (matches Node client routes)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # health
  RewriteRule ^health$ health.php [L,QSA]

  # auth
  RewriteRule ^auth/register$ auth/register.php [L,QSA]
  RewriteRule ^auth/login$ auth/login.php [L,QSA]
  RewriteRule ^auth/demo$ auth/demo.php [L,QSA]
  RewriteRule ^auth/me$ auth/me.php [L,QSA]
  RewriteRule ^auth/change-password$ auth/change-password.php [L,QSA]
  RewriteRule ^auth/forgot-password$ auth/forgot-password.php [L,QSA]
  RewriteRule ^auth/reset-password$ auth/reset-password.php [L,QSA]
  RewriteRule ^leads$ leads.php [L,QSA]
  RewriteRule ^leads-list$ leads-list.php [L,QSA]
  RewriteRule ^security-status$ security-status.php [L,QSA]
</IfModule>

# Pass Authorization header through on some Apache/CGI setups
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
